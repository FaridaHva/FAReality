DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Public origin for QR codes and share links. Use your LAN IP to test AR on a phone.
SITE_URL=http://localhost:3000

# Shown as the "Get in touch" button on the home page; hidden when empty.
CONTACT_EMAIL=

# Team admin at /admin (upload and publish models). Admin is off while this is empty.
ADMIN_PASSWORD=

# Where uploads are kept (relative to apps/web). Will move to Cloudflare R2 for production.
# STORAGE_DIR=../../.data/storage
